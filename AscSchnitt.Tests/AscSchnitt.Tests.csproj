<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>AscSchnitt.Tests</RootNamespace>
  </PropertyGroup>

  <!--
    The plugin project (AscSchnitt.csproj) references AutoCAD assemblies, so this test
    project does NOT reference it. Instead it compiles the AutoCAD-free source files
    directly, which keeps the tests runnable on any machine / CI without AutoCAD:

      dotnet test ./AscSchnitt.Tests/AscSchnitt.Tests.csproj
  -->
  <ItemGroup>
    <Compile Include="../AscSchnitt/AscGridHeader.cs" Link="Linked/AscGridHeader.cs" />
    <Compile Include="../AscSchnitt/AscGridTile.cs" Link="Linked/AscGridTile.cs" />
    <Compile Include="../AscSchnitt/AscGridIndex.cs" Link="Linked/AscGridIndex.cs" />
    <Compile Include="../AscSchnitt/SchnittSample.cs" Link="Linked/SchnittSample.cs" />
    <Compile Include="../AscSchnitt/SectionSampler.cs" Link="Linked/SectionSampler.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
