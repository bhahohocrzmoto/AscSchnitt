<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <AssemblyName>AscSchnitt</AssemblyName>
    <RootNamespace>AscSchnitt</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    Build with:
      dotnet build -c Release /p:AutoCADInstallDir="C:\Program Files\Autodesk\AutoCAD 2024"

    Adjust AutoCADInstallDir to the folder that contains AcMgd.dll and AcDbMgd.dll.
    For many AutoCAD Map 3D installations this is the main AutoCAD program folder.
  -->
  <PropertyGroup Condition="'$(AutoCADInstallDir)' == ''">
    <AutoCADInstallDir>C:\Program Files\Autodesk\AutoCAD 2024</AutoCADInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AcMgd">
      <HintPath>$(AutoCADInstallDir)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AutoCADInstallDir)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AutoCADInstallDir)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
